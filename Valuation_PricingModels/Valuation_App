    # Calculation Methods
    def calculate_dcf(self):
        try:
            self.update_parameters()
            fcf_list = [float(entry[3].get()) for entry in self.financial_entries if entry[3].get()]

            if len(fcf_list) < 2:
                messagebox.showerror("Error", "Need at least 2 years of Free Cash Flow data")
                return

            # Calculate historical growth rate
            growth_rates = [(fcf_list[i]/fcf_list[i-1] - 1) for i in range(1, len(fcf_list)) if fcf_list[i-1] != 0]
            avg_growth = np.mean(growth_rates) if growth_rates else 0.05

            # Project future cash flows
            last_fcf = fcf_list[-1]
            forecast_years = int(self.valuation_params['forecast_years'])
            wacc = self.valuation_params['wacc']
            terminal_growth = self.valuation_params['terminal_growth']

            projected_fcf = []
            pv_fcf = []

            for year in range(1, forecast_years + 1):
                fcf = last_fcf * ((1 + avg_growth) ** year)
                pv = fcf / ((1 + wacc) ** year)
                projected_fcf.append(fcf)
                pv_fcf.append(pv)

            # Calculate terminal value
            if self.terminal_method_var.get() == 'perpetuity':
                terminal_fcf = projected_fcf[-1] * (1 + terminal_growth)
                terminal_value = terminal_fcf / (wacc - terminal_growth)
            else:
                ev_ebitda = self.valuation_params['ev_ebitda_multiple']
                ebitda_list = [float(entry[1].get()) for entry in self.financial_entries if entry[1].get()]
                if ebitda_list:
                    last_ebitda = ebitda_list[-1]
                    terminal_value = last_ebitda * ev_ebitda
                else:
                    terminal_value = projected_fcf[-1] * 10  # fallback

            pv_terminal = terminal_value / ((1 + wacc) ** forecast_years)

            enterprise_value = sum(pv_fcf) + pv_terminal
            equity_value = enterprise_value - self.company_data['debt'] + self.company_data['cash']
            shares = self.company_data['shares_outstanding']
            value_per_share = equity_value / shares if shares > 0 else 0

            # Display results
            result = f"DCF VALUATION RESULTS\n"
            result += f"{'='*60}\n\n"
            result += f"Company: {self.company_data['name']}\n"
            result += f"Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n"
            result += f"ASSUMPTIONS:\n"
            result += f"  WACC: {wacc*100:.2f}%\n"
            result += f"  Terminal Growth: {terminal_growth*100:.2f}%\n"
            result += f"  Forecast Period: {forecast_years} years\n"
            result += f"  Historical Avg Growth: {avg_growth*100:.2f}%\n\n"

            result += f"PROJECTED FREE CASH FLOWS:\n"
            for i, (fcf, pv) in enumerate(zip(projected_fcf, pv_fcf), 1):
                result += f"  Year {i}: ${fcf/1e6:.2f}M (PV: ${pv/1e6:.2f}M)\n"

            result += f"\nTERMINAL VALUE:\n"
            result += f"  Terminal Value: ${terminal_value/1e6:.2f}M\n"
            result += f"  PV of Terminal Value: ${pv_terminal/1e6:.2f}M\n\n"

            result += f"VALUATION:\n"
            result += f"  Enterprise Value: ${enterprise_value/1e6:.2f}M\n"
            result += f"  Less: Debt: ${self.company_data['debt']/1e6:.2f}M\n"
            result += f"  Add: Cash: ${self.company_data['cash']/1e6:.2f}M\n"
            result += f"  Equity Value: ${equity_value/1e6:.2f}M\n"
            result += f"  Shares Outstanding: {shares/1e6:.2f}M\n"
            result += f"  VALUE PER SHARE: ${value_per_share:.2f}\n"

            self.dcf_result_text.delete('1.0', tk.END)
            self.dcf_result_text.insert('1.0', result)

            # Create chart
            self.dcf_figure.clear()
            ax = self.dcf_figure.add_subplot(111)
            years = [f"Year {i}" for i in range(1, forecast_years + 1)] + ['Terminal']
            values = projected_fcf + [terminal_value]
            ax.bar(years, [v/1e6 for v in values], color='steelblue')
            ax.set_ylabel('Value ($M)')
            ax.set_title('Projected Cash Flows & Terminal Value')
            ax.tick_params(axis='x', rotation=45)
            self.dcf_figure.tight_layout()
            self.dcf_canvas.draw()

        except Exception as e:
            messagebox.showerror("Error", f"DCF calculation failed: {str(e)}")

    def calculate_multiples(self):
        try:
            result = f"MULTIPLES VALUATION RESULTS\n"
            result += f"{'='*60}\n\n"
            result += f"Company: {self.company_data['name']}\n\n"

            # Get latest financial data
            revenue_list = [float(entry[0].get()) for entry in self.financial_entries if entry[0].get()]
            ebitda_list = [float(entry[1].get()) for entry in self.financial_entries if entry[1].get()]
            net_income_list = [float(entry[2].get()) for entry in self.financial_entries if entry[2].get()]

            if not revenue_list:
                messagebox.showerror("Error", "No revenue data available")
                return

            latest_revenue = revenue_list[-1]
            latest_ebitda = ebitda_list[-1] if ebitda_list else 0
            latest_net_income = net_income_list[-1] if net_income_list else 0

            shares = self.company_data['shares_outstanding']
            debt = self.company_data['debt']
            cash = self.company_data['cash']

            # P/E Multiple
            pe_multiple = self.valuation_params['pe_multiple']
            pe_equity_value = latest_net_income * pe_multiple
            pe_value_per_share = pe_equity_value / shares if shares > 0 else 0

            result += f"P/E MULTIPLE VALUATION:\n"
            result += f"  Latest Net Income: ${latest_net_income/1e6:.2f}M\n"
            result += f"  P/E Multiple: {pe_multiple:.1f}x\n"
            result += f"  Equity Value: ${pe_equity_value/1e6:.2f}M\n"
            result += f"  Value per Share: ${pe_value_per_share:.2f}\n\n"

            # EV/EBITDA Multiple
            ev_ebitda_multiple = self.valuation_params['ev_ebitda_multiple']
            enterprise_value = latest_ebitda * ev_ebitda_multiple
            ev_ebitda_equity_value = enterprise_value - debt + cash
            ev_ebitda_value_per_share = ev_ebitda_equity_value / shares if shares > 0 else 0

            result += f"EV/EBITDA MULTIPLE VALUATION:\n"
            result += f"  Latest EBITDA: ${latest_ebitda/1e6:.2f}M\n"
            result += f"  EV/EBITDA Multiple: {ev_ebitda_multiple:.1f}x\n"
            result += f"  Enterprise Value: ${enterprise_value/1e6:.2f}M\n"
            result += f"  Equity Value: ${ev_ebitda_equity_value/1e6:.2f}M\n"
            result += f"  Value per Share: ${ev_ebitda_value_per_share:.2f}\n\n"

            # P/S Multiple
            ps_multiple = self.valuation_params['ps_multiple']
            ps_equity_value = latest_revenue * ps_multiple
            ps_value_per_share = ps_equity_value / shares if shares > 0 else 0

            result += f"P/S MULTIPLE VALUATION:\n"
            result += f"  Latest Revenue: ${latest_revenue/1e6:.2f}M\n"
            result += f"  P/S Multiple: {ps_multiple:.1f}x\n"
            result += f"  Equity Value: ${ps_equity_value/1e6:.2f}M\n"
            result += f"  Value per Share: ${ps_value_per_share:.2f}\n\n"

            # Average
            avg_value = np.mean([pe_value_per_share, ev_ebitda_value_per_share, ps_value_per_share])
            result += f"AVERAGE VALUE PER SHARE: ${avg_value:.2f}\n"

            self.multiples_result_text.delete('1.0', tk.END)
            self.multiples_result_text.insert('1.0', result)

        except Exception as e:
            messagebox.showerror("Error", f"Multiples calculation failed: {str(e)}")

    def calculate_gordon(self):
        try:
            result = f"GORDON GROWTH MODEL RESULTS\n"
            result += f"{'='*60}\n\n"
            result += f"Company: {self.company_data['name']}\n\n"

            dividend_list = [float(entry[6].get()) for entry in self.financial_entries if entry[6].get()]

            if not dividend_list:
                result += "No dividend data available. Gordon Growth Model requires dividend payments.\n"
                self.gordon_result_text.delete('1.0', tk.END)
                self.gordon_result_text.insert('1.0', result)
                return

            latest_dividend = dividend_list[-1]
            shares = self.company_data['shares_outstanding']
            dividend_per_share = latest_dividend / shares if shares > 0 else 0

            g = self.valuation_params['dividend_growth']
            r = self.valuation_params['required_return']

            if r <= g:
                result += "Error: Required return must be greater than dividend growth rate.\n"
                self.gordon_result_text.delete('1.0', tk.END)
                self.gordon_result_text.insert('1.0', result)
                return

            # Gordon Growth Model: P = D1 / (r - g)
            next_dividend = dividend_per_share * (1 + g)
            value_per_share = next_dividend / (r - g)

            result += f"ASSUMPTIONS:\n"
            result += f"  Current Dividend per Share: ${dividend_per_share:.2f}\n"
            result += f"  Dividend Growth Rate: {g*100:.2f}%\n"
            result += f"  Required Return: {r*100:.2f}%\n\n"

            result += f"CALCULATION:\n"
            result += f"  Next Year Dividend (D1): ${next_dividend:.2f}\n"
            result += f"  VALUE PER SHARE: ${value_per_share:.2f}\n\n"

            result += f"Total Equity Value: ${value_per_share * shares / 1e6:.2f}M\n"

            self.gordon_result_text.delete('1.0', tk.END)
            self.gordon_result_text.insert('1.0', result)

        except Exception as e:
            messagebox.showerror("Error", f"Gordon Growth calculation failed: {str(e)}")
